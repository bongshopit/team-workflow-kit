+package com.lego.order;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import org.junit.jupiter.api.Test;
+
+class OrderServiceTest {
+    private static final class StubInventory implements InventoryClient {
+        private int available;
+        private int reservedQuantity;
+        private int releasedQuantity;
+
+        private StubInventory(int available) {
+            this.available = available;
+        }
+
+        public int available(String sku) {
+            return available;
+        }
+
+        @Override
+        public int reserve(String sku, int quantity) {
+            if (quantity <= 0) throw new ApiException(400, "quantity must be positive");
+            if (quantity > available) throw new ApiException(409, "insufficient stock for " + sku);
+            available -= quantity;
+            reservedQuantity += quantity;
+            return available;
+        }
+
+        @Override
+        public int release(String sku, int quantity) {
+            if (quantity <= 0) throw new ApiException(400, "quantity must be positive");
+            available += quantity;
+            releasedQuantity += quantity;
+            return available;
+        }
+    }
+
+    @Test
+    void createReservesStockForTheOrder() {
+        StubInventory inventory = new StubInventory(10);
+        OrderService service = new OrderService(inventory);
+
+        Order order = service.create("SKU-1", 2);
+
+        assertEquals("open", service.get(order.id()).status());
+        assertEquals(8, inventory.available("SKU-1"));
+        assertEquals(2, inventory.reservedQuantity);
+    }
+
+    @Test
+    void createFailsWhenInventoryCannotReserveStock() {
+        StubInventory inventory = new StubInventory(1);
+        OrderService service = new OrderService(inventory);
+
+        ApiException e = assertThrows(ApiException.class, () -> service.create("SKU-1", 2));
+
+        assertEquals(409, e.status());
+        assertEquals(1, inventory.available("SKU-1"));
+        assertThrows(ApiException.class, () -> service.get("ORD-1"));
+    }
+
+    @Test
+    void createRejectsNonPositiveQuantity() {
+        StubInventory inventory = new StubInventory(10);
+        OrderService service = new OrderService(inventory);
+
+        ApiException e = assertThrows(ApiException.class, () -> service.create("SKU-1", 0));
+
+        assertEquals(400, e.status());
+    }
+
+    @Test
+    void cancelReleasesInventoryOnce() {
+        StubInventory inventory = new StubInventory(10);
+        OrderService service = new OrderService(inventory);
+        Order order = service.create("SKU-1", 2);
+
+        Order cancelled = service.cancel(order.id());
+
+        assertEquals("cancelled", cancelled.status());
+        assertEquals(10, inventory.available("SKU-1"));
+        assertEquals(2, inventory.releasedQuantity);
+    }
+
+    @Test
+    void cancellingTwiceIsConflictAndDoesNotReleaseAgain() {
+        StubInventory inventory = new StubInventory(10);
+        OrderService service = new OrderService(inventory);
+        Order order = service.create("SKU-1", 2);
+        service.cancel(order.id());
+
+        ApiException e = assertThrows(ApiException.class, () -> service.cancel(order.id()));
+
+        assertEquals(409, e.status());
+        assertEquals(10, inventory.available("SKU-1"));
+        assertEquals(2, inventory.releasedQuantity);
+    }
+
+    @Test
+    void unknownOrderIsNotFound() {
+        StubInventory inventory = new StubInventory(10);
+        OrderService service = new OrderService(inventory);
+
+        ApiException e = assertThrows(ApiException.class, () -> service.get("nope"));
+
+        assertEquals(404, e.status());
+    }
+}
